              <TextBlock Grid.Row="1" Text="{DynamicResource UI_MapsSize}"/><TextBlock x:Name="ContentMapsSizeText" Grid.Row="1" Grid.Column="1" Text="0 B" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="{DynamicResource UI_PluginsSize}"/><TextBlock x:Name="ContentPluginsSizeText" Grid.Row="2" Grid.Column="1" Text="0 B" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="{DynamicResource UI_ConfigSize}"/><TextBlock x:Name="ContentConfigSizeText" Grid.Row="3" Grid.Column="1" Text="0 B" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="4" Text="{DynamicResource UI_TacticalData}"/><TextBlock x:Name="ContentTacticalSizeText" Grid.Row="4" Grid.Column="1" Text="0 B" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="5" Text="{DynamicResource UI_Other}"/><TextBlock x:Name="ContentOtherSizeText" Grid.Row="5" Grid.Column="1" Text="0 B" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/package.png" Width="28" Height="28" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource UI_Generated}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="GeneratedFileNameText" Text="—" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,11,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="GeneratedFilePathText" Text="—" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="GeneratedFileSizeText" Text="0 B" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"/>
            <Button Content="{DynamicResource SaveQrPng}" Click="SaveQr_Click" Style="{StaticResource IconActionButton}" HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/package.png" Width="28" Height="28" Margin="0,0,9,0"/><TextBlock Text="{DynamicResource UI_Qr}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <TextBlock Text="{DynamicResource UI_QrHelp}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <Image x:Name="QrImage" Height="150" Width="150" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,2,0,8"/>
            <TextBox x:Name="UrlText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="42" Margin="0,0,0,7"/>
            <StackPanel Orientation="Horizontal"><Button Content="{DynamicResource StartLan}" Click="StartServer_Click" Style="{StaticResource IconActionButton}" Margin="0,0,6,0"/><Button Content="{DynamicResource Stop}" Click="StopServer_Click" Style="{StaticResource IconActionButton}"/></StackPanel>
            <Button Content="{DynamicResource SaveQrPng}" Click="SaveQr_Click" Style="{StaticResource IconActionButton}" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}" Padding="14">
          <StackPanel>
            <TextBlock Text="{DynamicResource CloudDistribution}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource CloudHelp}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
            <TextBlock Text="{DynamicResource LocalPackage}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CloudPackageBox" TextWrapping="Wrap" MinHeight="36"/>
            <Button Content="{DynamicResource SelectFtak}" Click="SelectCloudPackage_Click" Style="{StaticResource IconActionButton}" Margin="0,6,0,6"/>
            <TextBlock Text="{DynamicResource ExternalPackageUrl}" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CloudUrlBox" TextWrapping="Wrap" MinHeight="48"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="{DynamicResource TestCloudLink}" Click="TestCloudLink_Click" Style="{StaticResource IconActionButton}" Margin="0,0,6,0"/><Button Content="{DynamicResource GenerateCloudQr}" Click="GenerateCloudQr_Click" Style="{StaticResource IconActionButton}"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="{DynamicResource CopyDeepLink}" Click="CopyCloudDeepLink_Click" Style="{StaticResource IconActionButton}" Margin="0,0,6,0"/><Button Content="{DynamicResource SaveQrPng}" Click="SaveQr_Click" Style="{StaticResource IconActionButton}"/></StackPanel>
            <TextBlock x:Name="CloudStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

    <!-- Non-visual functional controls kept for the 2.3 engine and advanced flows. -->
    <Grid Grid.Column="1" Grid.Row="1" Visibility="Collapsed">
      <Button Content="New Project" Click="NewProject_Click"/><Button Content="Import Legacy" Click="ImportLegacy_Click"/><Button Content="CloudDistribution" Click="GenerateCloudQr_Click"/><TextBlock Text="CloudDistribution"/><Border AllowDrop="True" Tag="atak" DragOver="ProjectFolder_DragOver" Drop="ProjectFolder_Drop"/>
            <TextBox x:Name="IdBox"/><TextBox x:Name="VersionBox" Text="2.3.0"/><TextBox x:Name="PublisherBox"/><TextBox x:Name="SourceBox"/><TextBox x:Name="OutputBox"/><TextBox x:Name="MaxDownloadsBox" Text="50"/>
      <TextBox x:Name="ServerTypeBox" Text="OpenTAK"/>
      <TextBlock x:Name="AtakCountText"/><TextBlock x:Name="PluginsCountText"/><TextBlock x:Name="MapsCountText"/><TextBlock x:Name="OverlaysCountText"/><TextBlock x:Name="ConfigCountText"/><TextBlock x:Name="DataCountText"/><TextBlock x:Name="MeshtasticCountText"/>
      <TextBox x:Name="StatusBox"/>
      <ListView x:Name="ContentList"/><Button Content="Browse" Click="BrowseSource_Click"/><Button Content="Browse" Click="BrowseOutput_Click"/>
    </Grid>
    </Grid>
  </ScrollViewer>
</Window>
