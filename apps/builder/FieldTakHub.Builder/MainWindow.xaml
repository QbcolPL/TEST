<Window x:Class="FieldTakHub.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIELD TAK HUB — C2 COMMAND CENTER v4.0"
        Width="1440" Height="900"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#060D10"
        Foreground="#E8F1F5">

    <Grid x:Name="RootShellGrid" Background="#060D10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWY PASEK BOCZNY (SIDEBAR C2) -->
        <Border x:Name="SidebarContainer"
                Grid.Column="0"
                Background="#0A151B"
                BorderBrush="#1B3B4B"
                BorderThickness="0,0,1.5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nagłówek Paska Bocznego + Przycisk Zwijania (❮ / ❯) -->
                <Border Grid.Row="0"
                        BorderBrush="#16303D"
                        BorderThickness="0,0,0,1"
                        Padding="10,12,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="BrandHeaderPanel"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="🛡️"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="2,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FIELD TAK HUB"
                                           Foreground="#1FE0C5"
                                           FontWeight="Bold"
                                           FontSize="13.5"/>
                                <TextBlock x:Name="SidebarSubtitleText"
                                           Text="BUILDER v4.0 C2"
                                           Foreground="#8AA8B5"
                                           FontSize="10.5"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="SidebarToggleBtn"
                                Grid.Column="1"
                                Content="❮"
                                Width="34" Height="34"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Background="#10242E"
                                Foreground="#1FE0C5"
                                BorderBrush="#1FE0C5"
                                BorderThickness="1.2"
                                FontWeight="Bold"
                                FontSize="14"
                                Cursor="Hand"
                                ToolTip="Zwiń / Rozwiń panel boczny"
                                Click="OnSidebarToggleClicked"/>
                    </Grid>
                </Border>

                <!-- Przyciski Nawigacji Modułów (Stała kolumna ikony 44px + Kolumna etykiety) -->
                <StackPanel Grid.Row="1" Margin="6,12,6,12">

                    <!-- Moduł 3: Konfigurator Stron & .FTAK -->
                    <Button x:Name="NavBtnPackages"
                            Height="46"
                            Margin="0,0,0,8"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="#12303D"
                            Foreground="#1FE0C5"
                            BorderBrush="#1FE0C5"
                            BorderThickness="1.5"
                            Cursor="Hand"
                            Click="OnNavPackagesClicked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="📦"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="NavLblPackages"
                                       Grid.Column="1"
                                       Text="Konfigurator Stron &amp; .FTAK"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                        </Grid>
                    </Button>

                    <!-- Moduł 1: Generator Map 1:1 -->
                    <Button x:Name="NavBtnMap"
                            Height="46"
                            Margin="0,0,0,8"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="#0D1D26"
                            Foreground="#E8F1F5"
                            BorderBrush="#1B3B4B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnNavMapClicked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🗺️"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="NavLblMap"
                                       Grid.Column="1"
                                       Text="Generator Map 1:1 (MGRS)"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                        </Grid>
                    </Button>

                    <!-- Moduł 2: Generator Rozkazu Bojowego OPORD -->
                    <Button x:Name="NavBtnOpord"
                            Height="46"
                            Margin="0,0,0,8"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="#0D1D26"
                            Foreground="#E8F1F5"
                            BorderBrush="#1B3B4B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnNavOpordClicked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="📋"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="NavLblOpord"
                                       Grid.Column="1"
                                       Text="Generator Rozkazu (OPORD)"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                        </Grid>
                    </Button>

                    <!-- Moduł 4: Masowy Programator Płytek USB -->
                    <Button x:Name="NavBtnUsb"
                            Height="46"
                            Margin="0,0,0,8"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="#0D1D26"
                            Foreground="#E8F1F5"
                            BorderBrush="#1B3B4B"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="OnNavUsbClicked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="🔌"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="NavLblUsb"
                                       Grid.Column="1"
                                       Text="Programator Płytek USB"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="2,0,8,0"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Stopka Paska Bocznego: Przełącznik Języka PL / EN oraz Folder Wspólny -->
                <Border Grid.Row="2"
                        BorderBrush="#16303D"
                        BorderThickness="0,1,0,0"
                        Padding="6,10,6,12">
                    <StackPanel>
                        <Button x:Name="LangSwitchBtn"
                                Height="38"
                                Margin="0,0,0,6"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="#132A36"
                                Foreground="#FAD02C"
                                BorderBrush="#FAD02C"
                                BorderThickness="1.2"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="OnLanguageToggleClicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LangFlagIcon"
                                           Grid.Column="0"
                                           Text="🇵🇱"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="LangBtnText"
                                           Grid.Column="1"
                                           Text="JĘZYK: PL (ZMIEŃ NA EN)"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="2,0,6,0"/>
                            </Grid>
                        </Button>

                        <Button x:Name="OpenSharedQuickBtn"
                                Height="36"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="#0D1D26"
                                Foreground="#1FE0C5"
                                BorderBrush="#1B3B4B"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnOpenSharedFolderClicked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📂"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock x:Name="OpenSharedQuickText"
                                           Grid.Column="1"
                                           Text="Folder wspolne/ &amp; out/"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="2,0,6,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- PRAWY OBSZAR ROBOCZY MODUŁÓW (Przełączanie 0 ms bez górnego paska) -->
        <Grid x:Name="ModuleHostGrid"
              Grid.Column="1"
              Background="#060D10"/>
    </Grid>
</Window>
