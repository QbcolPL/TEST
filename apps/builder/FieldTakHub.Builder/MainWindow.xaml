<!-- Legacy startup contract: Height="760" Width="1280" MinHeight="600" MinWidth="980" -->
<!-- 2.4 visual target: 1510×1000 with responsive work-area sizing. -->
<Window x:Class="FieldTakHub.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Field TAK Hub Builder 2.3.0"
        Height="1000" Width="1600" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        SnapsToDevicePixels="True" Background="#050F10" Foreground="#F0FAFA"
        Icon="Assets/tak-field-hub-builder.ico">
  <Window.Resources>
    <!-- 2.4 visual system: dark tactical UI, high contrast, cyan accent. -->
    <SolidColorBrush x:Key="Bg" Color="#050F10"/>
    <SolidColorBrush x:Key="Sidebar" Color="#061516"/>
    <SolidColorBrush x:Key="Topbar" Color="#08191B"/>
    <SolidColorBrush x:Key="Panel" Color="#071A1C"/>
    <SolidColorBrush x:Key="Panel2" Color="#0A2022"/>
    <SolidColorBrush x:Key="Input" Color="#061719"/>
    <SolidColorBrush x:Key="Border" Color="#123D40"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#0F3033"/>
    <SolidColorBrush x:Key="Accent" Color="#10E3ED"/>
    <SolidColorBrush x:Key="AccentDim" Color="#22AEB7"/>
    <SolidColorBrush x:Key="Text" Color="#EFF9F9"/>
    <SolidColorBrush x:Key="Muted" Color="#7C9B9F"/>
    <SolidColorBrush x:Key="Good" Color="#17E1E3"/>
    <SolidColorBrush x:Key="Black" Color="#031011"/>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Background" Value="#092023"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="#174A4E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0B3033"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentDim}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0E3B3F"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.46"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="13,13"/>
    </Style>

    <Style x:Key="NavIcon" TargetType="Image">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,0,15,0"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Opacity" Value="0.98"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Black}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="20,12"/>
    </Style>

    <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="#16484C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DarkCombo_PreviewMouseLeftButtonDown"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="#16484C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
              <ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <ToggleButton x:Name="DropDownButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0">
                <TextBlock Text="⌄" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
              </ToggleButton>
              <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="#07191B" BorderBrush="#1D5A5F" BorderThickness="1" CornerRadius="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="320" CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDim}"/></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#07191B"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#0A3033"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0D393C"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="#18373A" BorderBrush="#2C6165" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#6C8689" HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Thumb" Property="Fill" Value="#052022"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.45"/><Setter TargetName="Thumb" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style x:Key="SectionHeaderButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#09282A"/><Setter Property="BorderBrush" Value="#123D40"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#0D3538"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Window.Resources>

  <ScrollViewer x:Name="AppScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Background="{StaticResource Bg}">
    <Grid x:Name="AppLayout" Background="{StaticResource Bg}" Width="{Binding ViewportWidth, ElementName=AppScroll}" MinWidth="1280" MinHeight="1000" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="104"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Legacy UI24 layout contract: previous visual target used 340 / * / 330 and 108 top row. -->
    <!-- LEFT NAV -->
    <Border Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#123638" BorderThickness="0,0,1,0">
      <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="351"/></Grid.RowDefinitions>

        <StackPanel Margin="27,20,16,0">
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/field-tak-hub-2.3-icon.png" Width="78" Height="78" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="25" FontWeight="Bold"><Run Text="FIELD "/><Run Text="TAK" Foreground="{StaticResource Accent}"/><Run Text=" HUB"/></TextBlock>
              <TextBlock Text="connect · deploy · operate" Foreground="{StaticResource AccentDim}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10,9,10,0" Panel.ZIndex="20">
          <Button x:Name="NavPackageButton" Style="{StaticResource NavButton}" Background="#0A3437" BorderBrush="{StaticResource Accent}" BorderThickness="4,0,0,0" Click="NavPackage_Click">
            <StackPanel Orientation="Horizontal">
              <Image Source="Assets/navicons/package.png" Style="{StaticResource NavIcon}"/>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_Package}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI_NavPackageHelp}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
            </StackPanel>
          </Button>
          <Button x:Name="NavServerButton" Tag="server" Style="{StaticResource NavButton}" Click="NavServer_Click">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/server.png" Style="{StaticResource NavIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_NavServer}" FontSize="17"/><TextBlock Text="{DynamicResource UI_NavServerHelp}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
          </Button>
          <Button x:Name="NavMeshtasticButton" Style="{StaticResource NavButton}" Click="NavMeshtastic_Click">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/meshtastic.png" Style="{StaticResource NavIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_NavMeshtastic}" FontSize="17"/><TextBlock Text="{DynamicResource UI_NavMeshtasticHelp}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
          </Button>
          <Button x:Name="NavAtakButton" Style="{StaticResource NavButton}" Click="NavAtak_Click">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/atak.png" Style="{StaticResource NavIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_NavAtak}" FontSize="17"/><TextBlock Text="{DynamicResource UI_NavAtakHelp}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="225"/></StackPanel></StackPanel>
          </Button>
          <Button x:Name="NavCertsButton" Style="{StaticResource NavButton}" Click="NavCerts_Click">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/certs.png" Style="{StaticResource NavIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_NavCerts}" FontSize="17"/><TextBlock Text="{DynamicResource UI_NavCertsHelp}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="225"/></StackPanel></StackPanel>
          </Button>
          <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Click="NavSettings_Click">
            <StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/settings.png" Style="{StaticResource NavIcon}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource UI_NavSettings}" FontSize="17"/><TextBlock Text="{DynamicResource UI_NavSettingsHelp}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
          </Button>
        </StackPanel>
        <!-- 2.4 concept art: exact supplied Field TAK Hub soldier artwork. -->
        <Grid Grid.Row="2" Background="{StaticResource Sidebar}">
          <Image Source="Assets/field_tak_soldier.png" Width="322" Height="351" HorizontalAlignment="Center" VerticalAlignment="Bottom" Stretch="Fill"/>
        </Grid>
      </Grid>
    </Border>

    <!-- TOP BAR -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="{StaticResource Topbar}" BorderBrush="#123638" BorderThickness="0,0,0,1">
      <Grid Margin="21,0,17,0">
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource UI_Header}" FontSize="25" FontWeight="Bold"/>
            <Border Background="#0A5E63" CornerRadius="4" Padding="10,4" Margin="11,0,0,0">
              <TextBlock Text="BETA" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{DynamicResource UI_Subtitle}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="TAK" FontSize="17" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center"/>
          <TextBlock Text="{DynamicResource UI_TopTagline}" Foreground="{StaticResource AccentDim}" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
          <TextBlock Text="{DynamicResource UI_Language}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="LanguageBox" Width="72" Height="34" Style="{StaticResource DarkCombo}" SelectionChanged="LanguageBox_SelectionChanged" AutomationProperties.Name="Language">
            <ComboBoxItem Tag="pl" Content="PL" IsSelected="True"/>
            <ComboBoxItem Tag="en" Content="EN"/>
          </ComboBox>
          <Button Content="⚙" Style="{StaticResource NavButton}" Width="44" Height="44" Padding="0" Margin="10,0,0,0" Foreground="{StaticResource Accent}" Click="NavSettings_Click" ToolTip="Ustawienia"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- CENTER -->
    <Grid Grid.Column="1" Grid.Row="1" Margin="17,14,17,13">
      <Grid.RowDefinitions>
        <RowDefinition Height="86"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="66"/>
      </Grid.RowDefinitions>

      <!-- package header -->
      <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,13">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/navicons/package.png" Width="46" Height="46" Margin="0,0,14,0"/>
            <StackPanel>
              <TextBlock Text="{DynamicResource UI_Package}" FontSize="29" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource UI_PackageHelp}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="{DynamicResource ImportFtakButton}" Click="ImportFtak_Click" Style="{StaticResource IconActionButton}" Margin="0,0,8,0" ToolTip="{DynamicResource ImportFtakToolTip}"/>
            <TextBlock Text="{DynamicResource BuilderModeLabel}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="BuilderModeBox" Width="198" Height="42" Style="{StaticResource DarkCombo}" SelectionChanged="BuilderModeBox_SelectionChanged">
              <ComboBoxItem Tag="simple" Content="{DynamicResource UI_Simple}" IsSelected="True"/>
              <ComboBoxItem Tag="advanced" Content="{DynamicResource UI_Advanced}"/>
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>

      <!-- section 1 -->
      <Border Grid.Row="1" Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0"><Image Source="Assets/navicons/server.png" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource UI_EventInfo}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="{DynamicResource UI_EventName}" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Height="38" Text="MILS​IM 2026"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{DynamicResource UI_Profile}" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="EventProfileBox" Style="{StaticResource DarkCombo}" Height="38"><ComboBoxItem Content="{DynamicResource UI_MILSIMProfile}" IsSelected="True"/><ComboBoxItem Content="{DynamicResource UI_TrainingProfile}"/><ComboBoxItem Content="{DynamicResource UI_EventProfile}"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{DynamicResource UI_PackageValidity}" Style="{StaticResource FieldLabel}"/><Grid><TextBox x:Name="PackageExpiryBox" Height="38" Padding="10,7" Text="24"/><TextBlock Text="h" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/></Grid></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource UI_QrValidity}" Style="{StaticResource FieldLabel}"/><Grid><TextBox x:Name="QrExpiryBox" Height="38" Padding="10,7" Text="2"/><TextBlock Text="h" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/></Grid></StackPanel>

            <StackPanel Grid.ColumnSpan="4" VerticalAlignment="Bottom" Margin="0,70,0,0">
              <Grid><TextBlock Text="{DynamicResource UI_Description}" Style="{StaticResource FieldLabel}"/><TextBlock Text="39/200" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
              <TextBox x:Name="DescriptionBox" Height="36" Text="Konfiguracja uczestników - MILSIM 2026"/>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <TextBlock Text="Szybkie ustawienie:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <Button Content="6 h" Style="{StaticResource IconActionButton}" Click="SetPackage6_Click" Margin="0,0,5,0"/>
                <Button Content="24 h" Style="{StaticResource IconActionButton}" Click="SetPackage24_Click" Margin="0,0,5,0"/>
                <Button Content="48 h" Style="{StaticResource IconActionButton}" Click="SetPackage48_Click" Margin="0,0,5,0"/>
                <Button Content="6 h QR" Style="{StaticResource IconActionButton}" Click="SetQr6_Click" Margin="0,0,5,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- section 2 -->
      <Border Grid.Row="2" Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ContentsHeaderButton" Style="{StaticResource SectionHeaderButton}" Click="ContentsHeader_Click">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/navicons/package.png" Width="32" Height="32" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{DynamicResource UI_Contents}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Left"/><TextBlock Text="{DynamicResource UI_ContentsHelp}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Left"/></StackPanel></StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="{DynamicResource UI_Recommended}" Style="{StaticResource IconActionButton}" Click="RecommendedProfile_Click" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
              <Button Style="{StaticResource SectionHeaderButton}" Width="32" Height="32" Padding="0" Click="ContentsHeader_Click">
                <TextBlock x:Name="ContentsChevron" Text="⌃" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </Grid>

          <Grid x:Name="ContentsPanel" Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <!-- ATak -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,10" Padding="13" MinHeight="124">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/navicons/atak.png" Width="30" Height="30" Margin="0,0,9,0"/><TextBlock Text="ATAK" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="v5.6.0.13" Foreground="{StaticResource Accent}" Margin="38,-3,0,0"/><TextBlock Text="{DynamicResource UI_AtakDescription}" Foreground="{StaticResource Muted}" FontSize="12" Margin="38,3,0,0"/><Button Content="{DynamicResource UI_Configure}" Tag="atak" Click="PackageComponent_Click" Style="{StaticResource IconActionButton}" HorizontalAlignment="Right" Margin="0,10,0,0"/></StackPanel><CheckBox x:Name="AtakEnabledSwitch" Style="{StaticResource Switch}" IsChecked="True" Grid.Column="1"/></Grid>
            </Border>

            <!-- Plugins -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,10" Padding="13" MinHeight="124">
