<Window x:Class="FieldTakHub.Builder.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NewProject}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="18" MinWidth="430">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{DynamicResource NewProjectHelp}" TextWrapping="Wrap" Margin="4,0,4,10"/>
    <TextBlock Grid.Row="1" Text="{DynamicResource Name}"/>
    <TextBox Grid.Row="2" x:Name="ProjectNameBox" Text="GGZS STANDARD" AutomationProperties.Name="{DynamicResource Name}"/>
    <TextBlock Grid.Row="3" Text="{DynamicResource PackageId}"/>
    <TextBox Grid.Row="4" x:Name="PackageIdBox" Text="pl.ggzs.fieldtak.standard" AutomationProperties.Name="{DynamicResource PackageId}"/>
    <StackPanel Grid.Row="5">
      <TextBlock Text="{DynamicResource Version}"/>
      <TextBox x:Name="PackageVersionBox" Text="1.0.0" AutomationProperties.Name="{DynamicResource Version}"/>
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
      <Button Content="{DynamicResource CreateProject}" IsDefault="True" Click="Create_Click" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
