<Application x:Class="FieldTakHub.Builder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#060D10"/>
            <Setter Property="Background" Value="#DCE8EE"/>
            <Setter Property="BorderBrush" Value="#1FE0C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#060D10"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0A151B"/>
            <Setter Property="Foreground" Value="#1FE0C5"/>
            <Setter Property="BorderBrush" Value="#1FE0C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
        </Style>
    </Application.Resources>
</Application>
