'using System;',
'using System.Collections.Generic;',
'using System.IO;',
'using System.Linq;',
'namespace FieldTakHub.Builder.Services',
'{',
'    public static class SourceFileFilter',
'    {',
'        private static readonly HashSet<string> Ign = new(StringComparer.OrdinalIgnoreCase) { ".gitkeep", ".keep", ".placeholder", "placeholder.txt", "desktop.ini", "thumbs.db", ".ds_store" };',
'        public static bool IsValidDeploymentAsset(string filePath, string? categoryFolder = null)',
'        {',
'            if (string.IsNullOrWhiteSpace(filePath) || !File.Exists(filePath)) return false;',
'            var info = new FileInfo(filePath); if (info.Length <= 0) return false;',
'            string n = info.Name;',
'            if (Ign.Contains(n)) return false;',
'            if (n.StartsWith(".") || n.IndexOf("placeholder", StringComparison.OrdinalIgnoreCase) >= 0) return false;',
'            return true;',
'        }',
'        public static string[] GetFilteredFiles(string path, string searchPattern = "*", SearchOption searchOption = SearchOption.TopDirectoryOnly)',
'        {',
'            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path)) return Array.Empty<string>();',
'            TacticalConfigPanel.WriteGeneratedConfigsIfInteractive(path);',
'            return Directory.GetFiles(path, searchPattern, searchOption).Where(f => IsValidDeploymentAsset(f)).ToArray();',
'        }',
'        public static string[] GetFilteredFiles(string path, string searchPattern, EnumerationOptions options)',
'        {',
'            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path)) return Array.Empty<string>();',
'            TacticalConfigPanel.WriteGeneratedConfigsIfInteractive(path);',
'            return Directory.GetFiles(path, searchPattern, options).Where(f => IsValidDeploymentAsset(f)).ToArray();',
'        }',
'        public static IEnumerable<string> EnumerateFilteredFiles(string path, string searchPattern = "*", SearchOption searchOption = SearchOption.TopDirectoryOnly)',
'        {',
'            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path)) return Enumerable.Empty<string>();',
'            TacticalConfigPanel.WriteGeneratedConfigsIfInteractive(path);',
'            return Directory.EnumerateFiles(path, searchPattern, searchOption).Where(f => IsValidDeploymentAsset(f));',
'        }',
'        public static IEnumerable<string> EnumerateFilteredFiles(string path, string searchPattern, EnumerationOptions options)',
'        {',
'            if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path)) return Enumerable.Empty<string>();',
'            TacticalConfigPanel.WriteGeneratedConfigsIfInteractive(path);',
'            return Directory.EnumerateFiles(path, searchPattern, options).Where(f => IsValidDeploymentAsset(f));',
'        }',
'    }',
'}'
);
[IO.File]::WriteAllText([IO.Path]::Combine($svcDir,"SourceFileFilter.cs"),([string]::Join([Environment]::NewLine,$filterLines)),[Text.Encoding]::UTF8);

$mwPath=[IO.Path]::Combine($OutRepo,"apps\builder\FieldTakHub.Builder\MainWindow.xaml.cs");
if([IO.File]::Exists($mwPath)){
    $mw=[IO.File]::ReadAllText($mwPath,[Text.Encoding]::UTF8);
    if(!$mw.Contains("TacticalConfigPanel.AttachToMainWindow")){
        $inj="InitializeComponent();`r`n        Loaded += (_, __) => FieldTakHub.Builder.Services.TacticalConfigPanel.AttachToMainWindow(this);";
        $mw=[regex]::Replace($mw,"InitializeComponent\s*\(\s*\)\s*;",$inj,1);
        [IO.File]::WriteAllText($mwPath,$mw,[Text.Encoding]::UTF8);
    };
};

[Console]::WriteLine("[8/9] Synchronizacja versionName z version.json i pakowanie ZIP...");
$verJsonPath=[IO.Path]::Combine($OutRepo,"version.json");
$gradlePath=[IO.Path]::Combine($OutRepo,"apps\android\app\build.gradle.kts");
if([IO.File]::Exists($gradlePath)){
    $gr=[IO.File]::ReadAllText($gradlePath,[Text.Encoding]::UTF8);
    if(!$gr.Contains("com.google.zxing:core")){
        $gr=[regex]::Replace($gr,"(dependencies\s*\{)","`$1`r`n    implementation(`"com.google.zxing:core:3.5.3`")",1);
    };
    if([IO.File]::Exists($verJsonPath)){
        $vj=[IO.File]::ReadAllText($verJsonPath,[Text.Encoding]::UTF8);
        $mv=[regex]::Match($vj,'"version"\s*:\s*"([^"]+)"');
        if($mv.Success){
            $targetVer=$mv.Groups[1].Value;
            $gr=[regex]::Replace($gr,'versionName\s*=\s*"[^"]+"',('versionName = "' + $targetVer + '"'));
        };
    };
    [IO.File]::WriteAllText($gradlePath,$gr,[Text.Encoding]::UTF8);
};

if([IO.File]::Exists($OutZip)){[IO.File]::Delete($OutZip);};
[IO.Compression.ZipFile]::CreateFromDirectory($OutRepo,$OutZip);

[Console]::WriteLine("[9/9] Wysylanie na GitHub (QbcolPL/TEST)...");
$gitExe="git";
$g1=[IO.Path]::Combine($env:ProgramFiles,"Git\cmd\git.exe");
$g2=[IO.Path]::Combine($env:LOCALAPPDATA,"Programs\Git\cmd\git.exe");
if([IO.File]::Exists($g1)){$gitExe=$g1;}elseif([IO.File]::Exists($g2)){$gitExe=$g2;};

function Run-Git([string]$gitArgs) {
    $p = Start-Process -FilePath($gitExe) -ArgumentList($gitArgs) -WorkingDirectory($OutRepo) -NoNewWindow -Wait -PassThru;
    return $p.ExitCode;
}

[void](Run-Git "init");
[void](Run-Git "config user.name `"QbcolPL`"");
[void](Run-Git "config user.email `"QbcolPL@users.noreply.github.com`"");
[void](Run-Git "branch -M main");
[void](Run-Git "remote add origin https://github.com/QbcolPL/TEST.git");
[void](Run-Git "remote set-url origin https://github.com/QbcolPL/TEST.git");
[void](Run-Git "add -A");
[void](Run-Git "commit -m `"Safely reconstruct native ATAK card, apply real-time size update, fix CS0246 and ComboBox colors`"");
$pushCode = Run-Git "push -u origin main --force";

if($pushCode -eq 0){
    [Console]::WriteLine("SUKCES! Wersja ze stabilnym UI wyslana na GitHub!");
    [void]([Diagnostics.Process]::Start("https://github.com/QbcolPL/TEST/actions"));
}else{
    [Console]::WriteLine("[UWAGA] git push zwrocil kod: "+$pushCode);
};