    );
    $imp="import org.fieldtak.hub.deployment.DeploymentTaskState";
    if(!$maText.Contains($imp)){
        $maText=[regex]::Replace(
            $maText,
            "(package\s+org\.fieldtak\.hub\s*\r?\n)",
            "`$1$imp`r`n",
            1
        );
    };
    [IO.File]::WriteAllText(
        $mainActPath,$maText,[Text.Encoding]::UTF8
    );
};

$verJsonPath=[IO.Path]::Combine($OutRepo,"version.json");
$gradlePath=[IO.Path]::Combine($OutRepo,"apps\android\app\build.gradle.kts"
);
if([IO.File]::Exists($gradlePath)){
    $gr=[IO.File]::ReadAllText($gradlePath,[Text.Encoding]::UTF8);
    if(!$gr.Contains("com.google.zxing:core")){
        $zx='implementation("com.google.zxing:core:3.5.3")';
        $gr=[regex]::Replace($gr,"(dependencies\s*\{)","`$1`r`n    $zx",1
        );
    };
    if([IO.File]::Exists($verJsonPath)){
        $vj=[IO.File]::ReadAllText($verJsonPath,[Text.Encoding]::UTF8);
        $mv=[regex]::Match($vj,'"version"\s*:\s*"([^"]+)"');
        if($mv.Success){
            $targetVer=$mv.Groups[1].Value;
            $gr=[regex]::Replace(
                $gr,
                'versionName\s*=\s*"[^"]+"',
                ('versionName = "' + $targetVer + '"')
            );
            [Console]::WriteLine("   -> Zsynchronizowano versionName = "+$targetVer);
        };
    };
    [IO.File]::WriteAllText(
        $gradlePath,$gr,[Text.Encoding]::UTF8
    );
};

