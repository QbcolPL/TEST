Run-Git "config user.email `"QbcolPL@users.noreply.github.com`"" | Out-Null;
Run-Git "branch -M main" | Out-Null;
Run-Git "remote add origin https://github.com/QbcolPL/TEST.git" | Out-Null;
Run-Git "remote set-url origin https://github.com/QbcolPL/TEST.git" | Out-Null;
Run-Git "add -A" | Out-Null;
Run-Git "commit -m `"Add QR from gallery button and FTAK Package Library with delete support`"" | Out-Null;
$pushCode = Run-Git "push -u origin main --force";

