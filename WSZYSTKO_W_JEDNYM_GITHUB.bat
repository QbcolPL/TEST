if([IO.File]::Exists($themePath)){
    $th=[IO.File]::ReadAllText($themePath,[Text.Encoding]::UTF8);
    if(!$th.Contains("FirstRunAndDiagnosticsHost")){
        if($th.Contains("content = content")){
            $th=$th.Replace(
                "content = content",
                "content = { FirstRunAndDiagnosticsHost { content() } }"
            );
        }elseif($th.Contains("content()")){
            $th=$th.Replace(
                "content()",
                "FirstRunAndDiagnosticsHost { content() }"
            );
        };
        [IO.File]::WriteAllText(
            $themePath,$th,[Text.Encoding]::UTF8
        );
    };
};

[Console]::WriteLine("[8/10] Synchronizacja versionName z version.json dla tests/source_gate.py...");
$mainActPath=[IO.Path]::Combine(
